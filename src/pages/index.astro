---
import Card from "../components/Card.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/header.astro";
import Projects from "../components/Projects.astro";
import User from '../components/User.astro'
import BrifeCase from "../icons/BrifeCase.astro";
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>NolberthB</title>
</head>
<body class="min-h-screen flex flex-col">
  <main class="flex-grow flex flex-col items-center mb-10">
    <section id="main-container" class="container max-w-3xl mx-auto px-4">
      <Header />
      <User />

      <!-- === Experience === -->
      <h2 class="text-lg font-bold mb-0 flex gap-x-2 items-center">
        <BrifeCase class="size-5" />
        Work Experience
      </h2>
      <Card />

      <!-- === Projects === -->
      <h2 class="text-lg font-bold mb-0 flex gap-x-2 items-center">
        <BrifeCase class="size-5" />
        Proyectos
      </h2>
      <Projects />
    </section>
  </main>

  <Footer />
</body>

