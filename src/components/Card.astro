---
const experiences = [
  {
    role: "Senior Frontend Engineer",
    company: "IYK",
    duration: "2022 - present",
    description: "Building the Whole Wide World✕",
  },
  
];
---

<div class="bg-black text-white mt-7 mb-5"
  <div class="space-y-6">
    {experiences.map(exp => (
      <div class="border-s border-gray-400 dark:border-gray-400 pl-4 pb-7">
        <h3 class="text-lg font-semibold">
          {exp.role} – <span class="text-gray-400">{exp.company}</span>
        </h3>
        <span class="text-gray-500">{exp.duration}</span>
        <p class="text-sm mt-2 text-gray-300">{exp.description}</p>
      </div>
     ))}
    </div>
  </div>
</div>