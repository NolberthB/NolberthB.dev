---
import ProjectItem from "./Project-Item.astro";

const PROJECTS = [
  {
    title: "FlightBoard API",
    description: "Simulación de check-in automático para pasajeros de vuelos, con asignación inteligente de asientos según reglas de negocio.",
    link: "https://github.com/NolberthB/bsale-checkin",
    techs: ["Node.js", "Express", "MySQL", "Sequelize", "Joi", "Jest", "Render", "Pino"],
  },
 
  
];
---

<ol class="relative border-s border-gray-400 dark:border-gray-400 mt-7">
  {
    PROJECTS.map((project) => (
      <li class="mb-10 ms-4">
        <ProjectItem {...project} />
      </li>
    ))
  }
</ol>
